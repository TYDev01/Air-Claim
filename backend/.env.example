# AirClaim Oracle Backend — environment variable template
#
# Copy this file to .env and fill in every value marked REQUIRED.
# Optional fields have defaults shown in comments — leave them out to use the default.
#
# SECURITY: Never commit .env to version control.
#           Never log or expose SECRET fields.

# ─── Chain ────────────────────────────────────────────────────────────────────

# REQUIRED — HTTPS or WSS RPC endpoint for Celo.
# Use a private node (e.g. Infura, Alchemy, QuickNode) in production.
# Public endpoint (rate-limited): https://forno.celo.org
CELO_RPC_URL=https://forno.celo.org

# Expected chain ID. Startup fails if the RPC reports a different ID.
# 42220 = Celo mainnet | 44787 = Alfajores testnet
# Default: 42220
CHAIN_ID=42220

# ─── Wallet — SECRET ──────────────────────────────────────────────────────────

# REQUIRED — 0x-prefixed 32-byte private key of the updater wallet.
# This wallet must hold UPDATER_ROLE on the FlightOracle contract.
# Use a KMS or secrets manager in production; never hard-code in source.
UPDATER_PRIVATE_KEY=0x<64 hex characters>

# ─── Contract addresses ───────────────────────────────────────────────────────

# REQUIRED — Deployed FlightOracle contract address on the target chain.
FLIGHT_ORACLE_ADDRESS=0xc45c6d4C3fb5D3FEf8f09D30a4AFA2a992b84b5D

# REQUIRED — Deployed InsuredFlightsAgency contract address on the target chain.
INSURED_FLIGHTS_AGENCY_ADDRESS=0x9911b0aDD0e026B8091Ec0b1f4dF6893FF24F6A4

# ─── AviationStack — SECRET ───────────────────────────────────────────────────

# REQUIRED — AviationStack access key from https://aviationstack.com/dashboard
AVIATIONSTACK_API_KEY=<your-access-key>

# AviationStack API base URL.
# Free plan requires HTTP (no TLS); paid plans support HTTPS.
# Default: https://api.aviationstack.com/v1
# AVIATIONSTACK_BASE_URL=https://api.aviationstack.com/v1

# ─── Database — SECRET ────────────────────────────────────────────────────────

# REQUIRED — Prisma-compatible PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://oracle:changeme@localhost:5432/airclaim

# ─── Postgres (docker-compose only) — SECRET ──────────────────────────────────

# Used by docker-compose.yml to configure the Postgres service.
# Not read by the oracle process — DATABASE_URL is used instead.
POSTGRES_USER=oracle
POSTGRES_PASSWORD=changeme
POSTGRES_DB=airclaim

# ─── Transaction settings ─────────────────────────────────────────────────────

# Block confirmations to wait after mining before treating a tx as final.
# Default: 3
# TX_CONFIRMATIONS=3

# Seconds to wait for a tx to mine before resubmitting with a bumped fee.
# Default: 120
# TX_TIMEOUT_SECONDS=120

# Maximum submission attempts per outbox entry before marking it failed.
# Default: 5
# TX_MAX_ATTEMPTS=5

# Percentage to bump maxFeePerGas on each stuck-tx resubmit (EIP-1559 requires >= 10%).
# Default: 20
# TX_FEE_BUMP_PERCENT=20

# Absolute ceiling on maxFeePerGas in gwei. Prevents runaway fees.
# Default: 500
# TX_MAX_FEE_GWEI=500

# ─── Insurance / oracle parameters ───────────────────────────────────────────

# Delay threshold in minutes. MUST match the contract's delayThresholdMinutes.
# Default: 30
# DELAY_THRESHOLD_MINUTES=30

# Seconds between keeper checkFlightDelay calls for the same flight.
# Must be >= the contract's checkCooldownSeconds (300 on mainnet).
# Default: 300
# CHECK_COOLDOWN_SECONDS=300

# Seconds added to scheduledArrivalUtc to compute keeperEligibleAfter.
# Gives the flight grace time after landing before claims open.
# Default: 900  (15 minutes)
# KEEPER_BUFFER_SECONDS=900

# ─── Alerting ─────────────────────────────────────────────────────────────────

# Seconds without a confirmed oracle update before a staleness alert fires.
# Default: 3600  (1 hour)
# STALENESS_ALERT_SECONDS=3600

# Minimum CELO balance in wei for the updater wallet before a low-balance alert.
# Default: 100000000000000000  (0.1 CELO)
# MIN_UPDATER_BALANCE_WEI=100000000000000000

# Slack / Discord / generic webhook URL for alerts (optional).
# Payload: { "text": "<alert message>" }
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Telegram bot token and chat ID for alerts (both required together).
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# TELEGRAM_CHAT_ID=-1001234567890

# ─── HTTP server ──────────────────────────────────────────────────────────────

# Port for the Fastify health (/healthz) and metrics (/metrics) server.
# Default: 3000
# HTTP_PORT=3000

# Hostname to bind the HTTP server on. Use 0.0.0.0 inside Docker.
# Default: 0.0.0.0
# HTTP_HOST=0.0.0.0

# ─── Behaviour flags ──────────────────────────────────────────────────────────

# When true, log the intended tx but do NOT broadcast it to the chain.
# Safe for staging validation against mainnet state.
# Default: false
# DRY_RUN=false

# Pino log level: trace | debug | info | warn | error | fatal
# Default: info
# LOG_LEVEL=info

# ─── Indexer ──────────────────────────────────────────────────────────────────

# Block to start indexing FlightInsured events from on the first run.
# Set to the InsuredFlightsAgency deployment block for a fast first-run backfill.
# Default: 0  (genesis — slow on mainnet; always override this)
INDEX_FROM_BLOCK=28000000

# Maximum blocks per eth_getLogs call. Tune per RPC provider limits.
# Public RPCs: typically 1000-2000. Private nodes: up to 10000.
# Default: 2000
# INDEX_BATCH_SIZE=2000

# ─── AviationStack rate limiting ─────────────────────────────────────────────

# Maximum AviationStack API requests per hour this instance may issue.
# Basic plan (10,000/month)  -> ~13/h
# Professional (50,000/month) -> ~68/h
# Default: 13
# AVIATIONSTACK_MAX_RPH=13
