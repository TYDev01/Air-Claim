# ─── AirClaim Oracle Backend — environment variables ─────────────────────────
#
# Copy this file to .env and fill in every value before running.
# .env is gitignored. Never commit real secrets.
#
# Required fields are marked [REQUIRED].
# Optional fields show their default value.

# ── Chain ─────────────────────────────────────────────────────────────────────

# [REQUIRED] WebSocket or HTTPS RPC endpoint for Celo mainnet.
# Use a private node (Alchemy, QuickNode, Infura) in production.
CELO_RPC_URL=https://celo-mainnet.g.alchemy.com/v2/YOUR_KEY

# Expected chain ID. Defaults to 42220 (Celo mainnet).
# Override to 44787 for Alfajores testnet runs.
CHAIN_ID=42220

# ── Wallet ────────────────────────────────────────────────────────────────────

# [REQUIRED] 0x-prefixed private key of the updater wallet.
# This wallet must hold UPDATER_ROLE on FlightOracle.
# In production, source this from a KMS / secret manager instead of a plain file.
# ⚠️  Never commit or log this value.
UPDATER_PRIVATE_KEY=0x<your-updater-private-key>

# ── Contract addresses ────────────────────────────────────────────────────────

# [REQUIRED] Deployed FlightOracle address (Celo mainnet).
FLIGHT_ORACLE_ADDRESS=0xc45c6d4C3fb5D3FEf8f09D30a4AFA2a992b84b5D

# [REQUIRED] Deployed InsuredFlightsAgency address (Celo mainnet).
INSURED_FLIGHTS_AGENCY_ADDRESS=0x9911b0aDD0e026B8091Ec0b1f4dF6893FF24F6A4

# ── AviationStack ─────────────────────────────────────────────────────────────

# [REQUIRED] AviationStack API access key.
# Register at https://aviationstack.com/signup/free
# ⚠️  Never commit or log this value.
AVIATIONSTACK_API_KEY=<your-aviationstack-api-key>

# Base URL for the AviationStack API.
# Free plan: http (no TLS) — switch to https on a paid plan.
# Default: https://api.aviationstack.com/v1
# AVIATIONSTACK_BASE_URL=https://api.aviationstack.com/v1

# Max AviationStack API requests per hour this instance may make.
# Basic plan (10,000/month) ≈ 13/h. Professional (50,000/month) ≈ 68/h.
# Default: 13
# AVIATIONSTACK_MAX_RPH=13

# ── Database ──────────────────────────────────────────────────────────────────

# [REQUIRED] Prisma-compatible PostgreSQL connection string.
# For local development with docker-compose, use:
DATABASE_URL=postgresql://airclaim:airclaim@localhost:5432/airclaim

# ── Transaction settings ──────────────────────────────────────────────────────

# Block confirmations before a tx is treated as final. Default: 3
# TX_CONFIRMATIONS=3

# Seconds before a pending tx is considered stuck and resubmitted. Default: 120
# TX_TIMEOUT_SECONDS=120

# Maximum submission attempts per outbox entry before alerting. Default: 5
# TX_MAX_ATTEMPTS=5

# Percentage to bump maxFeePerGas on each resubmit (min 10 % for EIP-1559). Default: 20
# TX_FEE_BUMP_PERCENT=20

# Absolute ceiling on maxFeePerGas in gwei. Default: 500
# TX_MAX_FEE_GWEI=500

# ── Insurance / oracle parameters ─────────────────────────────────────────────

# Delay threshold in minutes — must match the deployed contract. Default: 30
# DELAY_THRESHOLD_MINUTES=30

# Seconds between keeper checkFlightDelay calls per flight. Default: 300
# Must be >= contract's checkCooldownSeconds (300 on mainnet).
# CHECK_COOLDOWN_SECONDS=300

# Seconds of buffer added to scheduled arrival before keeper becomes eligible. Default: 900
# KEEPER_BUFFER_SECONDS=900

# ── Alerting ──────────────────────────────────────────────────────────────────

# Seconds since last confirmed oracle update before staleness alert fires. Default: 3600
# STALENESS_ALERT_SECONDS=3600

# Minimum updater wallet CELO balance in wei before low-balance alert. Default: 0.1 CELO
# MIN_UPDATER_BALANCE_WEI=100000000000000000

# Slack / Discord incoming webhook URL (optional).
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Telegram bot token and chat ID (both required if using Telegram alerts).
# TELEGRAM_BOT_TOKEN=<bot-token>
# TELEGRAM_CHAT_ID=<chat-id>

# ── HTTP server ───────────────────────────────────────────────────────────────

# Port for the health/metrics HTTP server. Default: 3000
# HTTP_PORT=3000

# Hostname to bind. Use 0.0.0.0 inside Docker. Default: 0.0.0.0
# HTTP_HOST=0.0.0.0

# ── Behaviour ─────────────────────────────────────────────────────────────────

# Set to "true" to log intended transactions without broadcasting. Default: false
# DRY_RUN=false

# Pino log level. Default: info
# LOG_LEVEL=info

# ── Indexer ───────────────────────────────────────────────────────────────────

# Block to start indexing FlightInsured events from on first run.
# Set to the FlightOracle deployment block for faster startup.
# Default: 0
INDEX_FROM_BLOCK=0

# Maximum blocks per eth_getLogs batch call. Tune to your RPC provider's limits. Default: 2000
# INDEX_BATCH_SIZE=2000
