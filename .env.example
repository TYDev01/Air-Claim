# Private key of the deployer account (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# CeloScan API key for contract verification
# Register at https://celoscan.io/register
CELOSCAN_API_KEY=your_celoscan_api_key_here

# RPC URLs (defaults are public endpoints — use a private node for production)
CELO_RPC=https://forno.celo.org
ALFAJORES_RPC=https://alfajores-forno.celo-testnet.org

# Set to "true" to run integration tests against a mainnet fork
FORK=false

# Enable gas reporting in test output
REPORT_GAS=true
